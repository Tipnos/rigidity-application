# Not loaded by the application: export it in your shell before running
# (`set -a && source .env && set +a`) or use direnv.
# It is still read by sqlx at compile time (DATABASE_URL).
# Run `cargo run -- --help` to list every option.

# Required
SECRET_KEY=0123012301230123012301230123012301230123012301230123012301230123
STEAM_SECRET_ACCESS_KEY=

# Optional (defaults shown)
DATABASE_URL=postgres://postgres:password@localhost/postgres?sslmode=disable
#LISTEN_ADDRESS=127.0.0.1:8080
#RUST_LOG=rigidity_application=debug,tower_http=debug
#MAX_NB_WORKERS=
#MAX_DB_CONNS_WORKER=
#DEV_LOGIN=false
